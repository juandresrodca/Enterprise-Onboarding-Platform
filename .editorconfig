# EditorConfig — https://editorconfig.org
#
# This repository is four languages in one tree: a FastAPI backend on four-space
# Python, PowerShell that drives Active Directory and Entra from a Windows host,
# an Astro frontend on two-space markup, and the YAML that CI and the issue forms
# are written in. Nothing enforces a style — there is no ruff, black, prettier or
# eslint config anywhere in the repo — so until there is, this file is the only
# machine-readable statement of what the existing code already does.
#
# It was written by reading the tree rather than by picking defaults: every rule
# below matches the indentation the tracked files are already using.
#
# Most editors honour this natively; VS Code needs the EditorConfig extension.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Backend — PEP 8 four-space, as every module under backend/app already is.
# No max_line_length: the longest tracked line is 109 characters and nothing
# lints for it, so declaring 100 here would only start an argument this file
# exists to prevent.
[*.py]
indent_size = 4

[*.ini]
indent_size = 4

# PowerShell — CRLF, deliberately, and not an oversight of the [*] rule above.
# `.gitattributes` checks these scripts out as CRLF because they are opened in
# the ISE and in Windows PowerShell 5.1 on a domain-joined host, and nothing in
# CI runs pwsh. An editor writing LF here would be normalised straight back on
# commit, which is exactly the invisible churn that produced the 1,341-line
# no-op diff in #12. Keep the two files agreeing.
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

# Frontend — Astro, TypeScript and the config files beside them.
[*.{astro,ts,mjs,js,json,css}]
indent_size = 2

# CI definitions and issue forms. YAML cannot be indented with tabs at all.
[*.{yml,yaml}]
indent_size = 2

# Shell. `.githooks/commit-msg` and `.github/scripts/check-attribution.sh` both
# run under bash; the hook has no extension, so it is matched by name.
[*.sh]
indent_size = 2

[.githooks/*]
indent_size = 2
end_of_line = lf

# Container and reverse-proxy definitions — docker/nginx.conf is four-space.
[*.{conf,Dockerfile}]
indent_size = 4

# Markdown keeps trailing whitespace: two spaces at end of line is a hard break,
# and stripping them silently reflows the prose in README.md and docs/.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Generated by npm — never hand-edited, so do not fight the generator's format.
[frontend/package-lock.json]
indent_size = 2
insert_final_newline = false

# Verbatim third-party text. Left exactly as received.
[LICENSE]
indent_size = 4
trim_trailing_whitespace = false
